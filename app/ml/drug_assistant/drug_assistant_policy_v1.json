      "DailyMed/current prescribing information",
      "FDA",
      "MotherToBaby"
    ],
    "clinical_claim_requires_source": true,
    "if_no_current_source_and_no_reviewed_cache": "RETURN_INSUFFICIENT_EVIDENCE_OR_UNSUPPORTED",

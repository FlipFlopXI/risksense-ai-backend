{
  "artifact_name": "RiskSense Drug Assistant Policy",
  "authorization": {
    "admin": "Admin role alone does not grant patient-specific clinical-chat access.",
    "clinician": "May use patient-specific context only for an actively linked patient.",
    "effective_entitlement_required_for_patient_specific_chat": true,
    "patient": "May ask about own context only."
